# Copy to .env (docker compose reads it automatically). Demo defaults, change for real use.
POSTGRES_PASSWORD=metering
ADMIN_TOKEN=dev-admin-token
# Publish the service (:3000) and demo client (:8080) on localhost only. Recommended whenever the demo
# ADMIN_TOKEN above is in use. (Left unset by default: on some Docker Desktop/Windows setups an explicit
# 127.0.0.1 bind collides with host services, and one-command start must work everywhere.)
# BIND_ADDR=127.0.0.1

# Self-service signup: let anyone create an account without the admin token (the key comes back in the response).
# Off by default. Rate-limited per IP and capped; see docs/PROVISIONING.md.
# OPEN_SIGNUP=true
# SIGNUP_RATE_LIMIT_PER_MIN=10
# SIGNUP_MAX_ACCOUNTS=10000

# Host ports, if 3000 or 8080 are already taken on your machine (the containers still use 3000 / 8080 inside).
# SERVICE_PORT=3000
# CLIENT_PORT=8080
